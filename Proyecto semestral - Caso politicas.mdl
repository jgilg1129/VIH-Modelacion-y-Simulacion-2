{UTF-8}
Porcentaje de educación=
	0.85
	~	Dmnl
	~		|

Tasa de contagio=
	tasa de transmision incial*(1-efectividad de la educacion*Porcentaje de educación)
	~	1/year
	~		|

efectividad de la educacion=
	0.7
	~	Dmnl
	~		|

tasa de transmision incial=
	0.00025
	~	1/year
	~		|

Sin tratamiento=
	Contagiados del VIH*(1-tasa de tratamiento)
	~	personas/year
	~		|

Población total=
	Población Susceptible+Contagiados sin tratamiento+Contagiados en tratamiento
	~	personas
	~		|

Muertes con tratamiento=
	DELAY1(Tasa de mortalidad, Esperanza de vida con tratamiento )*Contagiados en tratamiento
	~	personas/year
	~		|

Contagiados en tratamiento= INTEG (
	En tratamiento-Muertes con tratamiento,
		5606)
	~	personas
	~		|

Contagiados sin tratamiento= INTEG (
	Sin tratamiento-Muertes sin tratamiento,
		1174)
	~	personas
	~		|

Esperanza de vida sin tratamiento=
	3
	~	year
	~		|

Esperanza de vida con tratamiento=
	50
	~	year
	~		|

Muertes por VIH= INTEG (
	Muertes con tratamiento+Muertes sin tratamiento,
		2200)
	~	personas
	~		|

Muertes sin tratamiento=
	DELAY1(Tasa de mortalidad, Esperanza de vida sin tratamiento )*Contagiados sin tratamiento
	~	personas/year
	~		|

tasa de tratamiento=
	0.825
	~	1/year
	~		|

Contagiados del VIH= INTEG (
	Incidencia de contagios-En tratamiento-Sin tratamiento,
		6780)
	~	personas
	~		|

En tratamiento=
	Contagiados del VIH*tasa de tratamiento
	~	personas/year
	~		|

Incidencia de contagios=
	Población Susceptible*Tasa de contagio
	~	personas/year
	~		|

Incremento poblacional=
	Población total*tasa de crecimiento neto
	~	personas/year
	~		|

Población Susceptible= INTEG (
	Incremento poblacional-Incidencia de contagios,
		4.4971e+07)
	~	personas
	~		|

tasa de crecimiento neto=
	0.011
	~	1/year
	~		|

Tasa de mortalidad=
	0.004
	~	1/year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2039
	~	year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2009
	~	year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	year [0,?]
	~	The time step for the simulation.
	|

